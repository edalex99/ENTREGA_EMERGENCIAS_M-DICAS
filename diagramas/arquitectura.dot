digraph Arq {
  graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.25", nodesep="0.38", ranksep="0.62", fontname="DejaVu Sans", label="Arquitectura concurrente - flujo y comunicación", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", color="#B9C7D8", fillcolor="#F0F5FA", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.12"];
  edge [color="#557088", arrowsize=0.65, penwidth=1.4];
  llamadas [label="Generador\nLlamadas simultáneas", fillcolor="#DBEAFE"];
  entrada [label="Cola de ingreso\nArrayBlockingQueue (250)"];
  operadores [label="Operadores\nExecutorService (3)"];
  coord [label="Coordinador\nCola pendiente + prioridad\nlock + reserva atómica", fillcolor="#D1FAE5", color="#83B9A5"];
  desp [label="Despachadores\nExecutorService (3)"];
  rec [label="Ambulancia + médico + kit\nrecursos indivisibles", fillcolor="#FFF3C6"];
  viajes [label="Equipos de ambulancia\nExecutorService (N)"];
  hospital [label="Hospital receptor\nBlockingQueue + hilo", fillcolor="#FCE7F3"];
  monitor [label="Monitor 1 s\nScheduledExecutorService", fillcolor="#EDE9FE"];
  reparacion [label="Reparación diferida\nScheduledExecutorService", fillcolor="#FEE2E2"];
  llamadas -> entrada -> operadores -> coord -> desp -> rec -> viajes;
  viajes -> hospital [label="mensajes"];
  viajes -> reparacion [label="fallo", color="#BA5C5C"];
  reparacion -> coord [label="aviso", style=dashed];
  coord -> monitor [label="snapshot", style=dashed];
}
